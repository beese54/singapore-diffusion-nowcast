# Copy this file to .env and fill in your actual keys.
# NEVER commit .env to git.

# NVIDIA NGC API key — get from https://ngc.nvidia.com → Account → Setup → API Key
NGC_API_KEY=your_ngc_api_key_here

# NVIDIA NIM API key — get from https://build.nvidia.com → your profile
NVIDIA_API_KEY=your_nvidia_nim_api_key_here

# Copernicus CDS API key — get from https://cds.climate.copernicus.eu
# Alternatively configure via ~/.cdsapirc (preferred)
CDS_API_KEY=your_cds_api_key_here
CDS_API_URL=https://cds.climate.copernicus.eu/api/v2

# Telegram API credentials — get from https://my.telegram.org/apps
# Required for scripts/collect_flood_labels.py (Stage 5 ground truth)
# Copy from predict_flash_flood/.env if already configured there.
TELEGRAM_API_ID=your_telegram_api_id_here
TELEGRAM_API_HASH=your_telegram_api_hash_here
